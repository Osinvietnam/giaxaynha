# ============================================================
# GiaXayNha.vn — Environment Variables
# Copy file này thành .env.local và điền giá trị thật
# KHÔNG commit .env.local lên git
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Lấy từ: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — CHỈ dùng server-side, KHÔNG public
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── N8n Webhooks ─────────────────────────────────────────────
# Lấy từ: N8n → Workflow W1 → Webhook node → URL

# W1: Notify Telegram khi có lead mới
N8N_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/lead-notify

# W3: Daily report (trigger từ N8n Cron, không cần ở đây)

# ── Google Drive ─────────────────────────────────────────────
# Service account credentials (dùng trong N8n, không cần ở Next.js)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=giaxaynha@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ── App config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GiaXayNha.vn
